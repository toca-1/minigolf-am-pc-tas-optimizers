+#include "minigolf_scan_impl.h"
+#include <algorithm>
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <unistd.h>
 /* chimera-run - the engine's headless runner.
  *
  * Loads a core package, a rom, and a movie input log; runs the movie; dumps
@@ -744,6 +749,1136 @@ int main(int argc, char **argv)
 		fprintf(stderr, "state file tag: %.*s\n", (int)(tagLen < sizeof tag ? tagLen : sizeof tag), (const char *)tag);
 	}
 
+/*
+	 * Pure planner / exhaustive-space precompute.
+	 *
+	 * No candidate emulation is performed here.  This enumerates every
+	 * legal Display Input coordinate, generates the exact PS/2 input
+	 * sequence, and deduplicates complete sequences.
+	 */
+	if (std::getenv("MINIGOLF_SCAN_PRECOMPUTE"))
+	{
+		try
+		{
+			return minigolf_scan::run_precompute();
+		}
+		catch (const std::exception &e)
+		{
+			return fail(
+				metaPath,
+				std::string(
+					"Minigolf precompute: ")
+				+ e.what());
+		}
+	}
+
+
+
+
+	/*
+	 * Minigolf exhaustive scanner.
+	 *
+	 * MINIGOLF_SCAN=1 enables it.
+	 *
+	 * Optional:
+	 *   MINIGOLF_SCAN_WORKER=N       0-based worker number
+	 *   MINIGOLF_SCAN_WORKERS=N      total worker count
+	 *   MINIGOLF_SCAN_MAX_FRAMES=N   initial ceiling (default 100)
+	 *   MINIGOLF_SCAN_LIMIT=N        only evaluate N assigned plans
+	 *                                (0/unset = no limit)
+	 *   MINIGOLF_SCAN_PROGRESS=N     progress interval (default 1000)
+	 *   MINIGOLF_SWITCH_DYNAMIC=1    normal -> dynamic_x86 on frame 0
+	 *
+	 * Plans are assigned by:
+	 *
+	 *   unique_plan_index % worker_count == worker
+	 *
+	 * Each worker keeps its own incumbent.  This is completely safe:
+	 * a worker with a worse incumbent merely runs some candidates for
+	 * longer; it cannot miss a candidate that beats the global optimum.
+	 *
+	 * We simulate THROUGH the incumbent frame, rather than stopping at
+	 * incumbent-1, so ties at the eventual optimum are also retained.
+	 */
+	if (std::getenv("MINIGOLF_SCAN"))
+	{
+		if (stateIn.empty())
+			return fail(
+				metaPath,
+				"MINIGOLF_SCAN requires --state");
+
+		auto envI64 =
+			[](const char *name,
+			   int64_t fallback) -> int64_t
+		{
+			const char *text = std::getenv(name);
+
+			if (!text || !text[0])
+				return fallback;
+
+			return std::atoll(text);
+		};
+
+		const int64_t worker =
+			envI64(
+				"MINIGOLF_SCAN_WORKER",
+				0);
+
+		const int64_t workerCount =
+			envI64(
+				"MINIGOLF_SCAN_WORKERS",
+				1);
+
+		const int64_t maxFrames =
+			envI64(
+				"MINIGOLF_SCAN_MAX_FRAMES",
+				100);
+
+		const int64_t scanLimit =
+			envI64(
+				"MINIGOLF_SCAN_LIMIT",
+				0);
+
+		const int64_t progressEvery =
+			envI64(
+				"MINIGOLF_SCAN_PROGRESS",
+				1000);
+
+		const int64_t scanXMin =
+			envI64(
+				"MINIGOLF_SCAN_X_MIN",
+				minigolf_scan::LEGAL_X_MIN);
+
+		const int64_t scanXMax =
+			envI64(
+				"MINIGOLF_SCAN_X_MAX",
+				minigolf_scan::LEGAL_X_MAX);
+
+		const int64_t scanYMin =
+			envI64(
+				"MINIGOLF_SCAN_Y_MIN",
+				minigolf_scan::LEGAL_Y_MIN);
+
+		const int64_t scanYMax =
+			envI64(
+				"MINIGOLF_SCAN_Y_MAX",
+				minigolf_scan::LEGAL_Y_MAX);
+
+
+		const int64_t scanCursorX =
+			envI64(
+				"MINIGOLF_SCAN_CURSOR_X",
+				minigolf_scan::CURSOR_X);
+
+		const int64_t scanCursorY =
+			envI64(
+				"MINIGOLF_SCAN_CURSOR_Y",
+				minigolf_scan::CURSOR_Y);
+
+		const int64_t scanStartAxisX =
+			envI64(
+				"MINIGOLF_SCAN_START_AXIS_X",
+				minigolf_scan::START_AXIS_X);
+
+		const int64_t scanStartAxisY =
+			envI64(
+				"MINIGOLF_SCAN_START_AXIS_Y",
+				minigolf_scan::START_AXIS_Y);
+
+		const int64_t scanStartHole =
+			envI64(
+				"MINIGOLF_SCAN_START_HOLE",
+				2);
+
+		const int64_t scanNextHole =
+			envI64(
+				"MINIGOLF_SCAN_NEXT_HOLE",
+				scanStartHole + 1);
+
+		const char *scanOrderText =
+			std::getenv(
+				"MINIGOLF_SCAN_ORDER");
+
+		const bool bottomUp =
+			scanOrderText
+			&& std::strcmp(
+				scanOrderText,
+				"bottom-up") == 0;
+
+		const char *sharedBestPath =
+			std::getenv(
+				"MINIGOLF_SCAN_SHARED_BEST_FILE");
+
+		if (workerCount <= 0)
+			return fail(
+				metaPath,
+				"MINIGOLF_SCAN_WORKERS must be > 0");
+
+		if (worker < 0 ||
+		    worker >= workerCount)
+			return fail(
+				metaPath,
+				"MINIGOLF_SCAN_WORKER is outside worker range");
+
+		if (maxFrames <= 0 ||
+		    maxFrames > 10000)
+			return fail(
+				metaPath,
+				"MINIGOLF_SCAN_MAX_FRAMES must be 1..10000");
+
+		if (scanLimit < 0)
+			return fail(
+				metaPath,
+				"MINIGOLF_SCAN_LIMIT must be >= 0");
+
+		if (scanXMin < minigolf_scan::LEGAL_X_MIN ||
+		    scanXMax > minigolf_scan::LEGAL_X_MAX ||
+		    scanYMin < minigolf_scan::LEGAL_Y_MIN ||
+		    scanYMax > minigolf_scan::LEGAL_Y_MAX ||
+		    scanXMin > scanXMax ||
+		    scanYMin > scanYMax)
+		{
+			return fail(
+				metaPath,
+				"scan rectangle is outside legal bounds");
+		}
+
+
+		if (scanCursorX < 0 || scanCursorX > 2560 ||
+		    scanCursorY < 0 || scanCursorY > 2048 ||
+		    scanStartAxisX < 0 || scanStartAxisX > 2560 ||
+		    scanStartAxisY < 0 || scanStartAxisY > 2048)
+		{
+			return fail(
+				metaPath,
+				"scan cursor/carrier is outside Display Input bounds");
+		}
+
+		if (scanStartHole < 0 || scanStartHole > 255 ||
+		    scanNextHole < 0 || scanNextHole > 255)
+		{
+			return fail(
+				metaPath,
+				"scan hole byte is outside u8 range");
+		}
+
+const char *switchText =
+			std::getenv(
+				"MINIGOLF_SWITCH_DYNAMIC");
+
+		const bool switchDynamic =
+			switchText
+			&& switchText[0] != '\0'
+			&& std::strcmp(
+				switchText,
+				"0") != 0;
+
+		constexpr int32_t
+			SEARCH_DYNAMIC_BUTTON = 11;
+
+		constexpr int64_t
+			HOLE_ADDRESS = 0x023DB7B8;
+
+		const uint8_t START_HOLE =
+			static_cast<uint8_t>(
+				scanStartHole);
+
+		const uint8_t NEXT_HOLE =
+			static_cast<uint8_t>(
+				scanNextHole);
+
+		/*
+		 * Re-read the exact common branch state.
+		 */
+		std::vector<uint8_t> baseState;
+
+		if (!readWholeFile(
+				stateIn.c_str(),
+				baseState))
+		{
+			return fail(
+				metaPath,
+				"scan: could not reread state");
+		}
+
+		/*
+		 * Locate Physical RAM.
+		 */
+		int32_t ramDomain = -1;
+
+		for (int32_t d = 0;
+		     d < ce_session_domain_count(session);
+		     d++)
+		{
+			const char *name =
+				ce_session_domain_name(
+					session,
+					d);
+
+			if (name
+			    && std::strcmp(
+				    name,
+				    "Physical RAM") == 0)
+			{
+				ramDomain = d;
+				break;
+			}
+		}
+
+		if (ramDomain < 0)
+			return fail(
+				metaPath,
+				"scan: Physical RAM not found");
+
+		const uint64_t ramPtrValue =
+			ce_session_domain_ptr(
+				session,
+				ramDomain);
+
+		if (ramPtrValue == 0)
+			return fail(
+				metaPath,
+				"scan: Physical RAM has no direct pointer");
+
+		const uint8_t *ram =
+			reinterpret_cast<const uint8_t *>(
+				static_cast<uintptr_t>(
+					ramPtrValue));
+
+		/*
+		 * Locate controls by name.
+		 */
+		auto findButton =
+			[&](const char *wanted) -> int32_t
+		{
+			for (int64_t i = 0;
+			     i < ce_session_button_count(session);
+			     i++)
+			{
+				const char *name =
+					ce_session_button_name(
+						session,
+						i);
+
+				if (name
+				    && std::strcmp(
+					    name,
+					    wanted) == 0)
+				{
+					return
+						static_cast<int32_t>(
+							i);
+				}
+			}
+
+			return -1;
+		};
+
+		auto findAxis =
+			[&](const char *wanted) -> int32_t
+		{
+			for (int64_t i = 0;
+			     i < ce_session_axis_count(session);
+			     i++)
+			{
+				const char *name =
+					ce_session_axis_name(
+						session,
+						i);
+
+				if (name
+				    && std::strcmp(
+					    name,
+					    wanted) == 0)
+				{
+					return
+						static_cast<int32_t>(
+							i);
+				}
+			}
+
+			return -1;
+		};
+
+		const int32_t mouseLeft =
+			findButton(
+				"Mouse Left Button");
+
+		const int32_t mouseX =
+			findAxis(
+				"Mouse Position X");
+
+		const int32_t mouseY =
+			findAxis(
+				"Mouse Position Y");
+
+		const int32_t mouseDX =
+			findAxis(
+				"Mouse Speed X");
+
+		const int32_t mouseDY =
+			findAxis(
+				"Mouse Speed Y");
+
+		if (mouseLeft < 0 ||
+		    mouseX < 0 ||
+		    mouseY < 0 ||
+		    mouseDX < 0 ||
+		    mouseDY < 0)
+		{
+			return fail(
+				metaPath,
+				"scan: DOSBox-X mouse controls not found");
+		}
+
+		if (switchDynamic
+		    && ce_session_button_count(session)
+		       <= SEARCH_DYNAMIC_BUTTON)
+		{
+			return fail(
+				metaPath,
+				"scan: dynamic-switch button missing");
+		}
+
+		auto setMouse =
+			[&](const minigolf_scan::MouseFrame &f)
+		{
+			ce_session_set_axis(
+				session,
+				mouseX,
+				f.x);
+
+			ce_session_set_axis(
+				session,
+				mouseY,
+				f.y);
+
+			ce_session_set_axis(
+				session,
+				mouseDX,
+				f.speedX);
+
+			ce_session_set_axis(
+				session,
+				mouseDY,
+				f.speedY);
+
+			ce_session_set_button(
+				session,
+				mouseLeft,
+				f.left);
+		};
+
+		const minigolf_scan::MouseFrame neutral{
+			1280,
+			1024,
+			0,
+			0,
+			0
+		};
+
+		std::fprintf(
+			stderr,
+			"\n=== Minigolf exhaustive scan ===\n"
+			"worker              : %lld / %lld\n"
+			"maximum initial run : %lld frames\n"
+			"execution core      : %s\n"
+			"state bytes         : %zu\n"
+			"enumerating plans...\n",
+			static_cast<long long>(
+				worker),
+			static_cast<long long>(
+				workerCount),
+			static_cast<long long>(
+				maxFrames),
+			switchDynamic
+				? "dynamic_x86 after frame-0 switch"
+				: "normal",
+			baseState.size());
+
+		std::fflush(stderr);
+
+		/*
+		 * This is the same exact full-screen enumeration used by
+		 * MINIGOLF_SCAN_PRECOMPUTE.
+		 */
+
+		minigolf_scan::configure_planner(
+			static_cast<int>(
+				scanCursorX),
+			static_cast<int>(
+				scanCursorY),
+			static_cast<int>(
+				scanStartAxisX),
+			static_cast<int>(
+				scanStartAxisY));
+
+std::vector<minigolf_scan::UniquePlan>
+			plans =
+				minigolf_scan::
+					enumerate_unique_plans_range(
+					static_cast<int>(scanXMin),
+					static_cast<int>(scanXMax),
+					static_cast<int>(scanYMin),
+					static_cast<int>(scanYMax));
+
+
+		if (bottomUp)
+		{
+			std::sort(
+				plans.begin(),
+				plans.end(),
+				[](const minigolf_scan::UniquePlan &a,
+				   const minigolf_scan::UniquePlan &b)
+				{
+					if (a.maxY != b.maxY)
+						return a.maxY > b.maxY;
+
+					return a.minX < b.minX;
+				});
+		}
+
+const size_t totalUnique =
+			plans.size();
+
+
+		std::fprintf(
+			stderr,
+			"cursor              : %lld,%lld\n"
+			"start carrier       : %lld,%lld\n"
+			"hole transition     : %lld -> %lld\n"
+			"search order        : %s\n",
+			static_cast<long long>(
+				scanCursorX),
+			static_cast<long long>(
+				scanCursorY),
+			static_cast<long long>(
+				scanStartAxisX),
+			static_cast<long long>(
+				scanStartAxisY),
+			static_cast<long long>(
+				scanStartHole),
+			static_cast<long long>(
+				scanNextHole),
+			bottomUp
+				? "bottom-up / left-to-right"
+				: "native");
+
+		if (!plans.empty())
+		{
+			std::fprintf(
+				stderr,
+				"first ordered plan  : raw=%d,%d y_bounds=%d..%d\n"
+				"last ordered plan   : raw=%d,%d y_bounds=%d..%d\n",
+				plans.front().canonicalX,
+				plans.front().canonicalY,
+				plans.front().minY,
+				plans.front().maxY,
+				plans.back().canonicalX,
+				plans.back().canonicalY,
+				plans.back().minY,
+				plans.back().maxY);
+		}
+
+size_t assignedTotal = 0;
+
+		if (static_cast<size_t>(worker)
+		    < totalUnique)
+		{
+			assignedTotal =
+				(totalUnique
+				 - 1
+				 - static_cast<size_t>(
+					 worker))
+				/ static_cast<size_t>(
+					workerCount)
+				+ 1;
+		}
+
+		if (scanLimit > 0
+		    && static_cast<uint64_t>(
+			    scanLimit)
+		       < assignedTotal)
+		{
+			assignedTotal =
+				static_cast<size_t>(
+					scanLimit);
+		}
+
+		std::fprintf(
+			stderr,
+			"raw X range         : %lld..%lld\n"
+			"raw Y range         : %lld..%lld\n"
+			"unique plans        : %zu\n"
+			"assigned to worker  : %zu\n"
+			"starting scan...\n\n",
+			static_cast<long long>(scanXMin),
+			static_cast<long long>(scanXMax),
+			static_cast<long long>(scanYMin),
+			static_cast<long long>(scanYMax),
+			totalUnique,
+			assignedTotal);
+
+		std::fflush(stderr);
+
+		/*
+		 * bestScore == maxFrames + 1 means we have not found an
+		 * HIO yet.
+		 */
+		int64_t bestScore =
+			maxFrames + 1;
+
+
+		int sharedBestFd = -1;
+		int32_t *sharedBest = nullptr;
+
+		if (sharedBestPath &&
+		    sharedBestPath[0])
+		{
+			sharedBestFd =
+				::open(
+					sharedBestPath,
+					O_RDWR);
+
+			if (sharedBestFd < 0)
+			{
+				return fail(
+					metaPath,
+					"scan: could not open shared-best file");
+			}
+
+			struct stat st{};
+
+			if (::fstat(
+					sharedBestFd,
+					&st) != 0 ||
+			    st.st_size <
+				    static_cast<off_t>(
+					    sizeof(int32_t)))
+			{
+				return fail(
+					metaPath,
+					"scan: shared-best file is invalid");
+			}
+
+			void *mapping =
+				::mmap(
+					nullptr,
+					sizeof(int32_t),
+					PROT_READ |
+						PROT_WRITE,
+					MAP_SHARED,
+					sharedBestFd,
+					0);
+
+			if (mapping == MAP_FAILED)
+			{
+				return fail(
+					metaPath,
+					"scan: mmap shared-best failed");
+			}
+
+			sharedBest =
+				static_cast<int32_t *>(
+					mapping);
+
+			std::fprintf(
+				stderr,
+				"shared incumbent    : %d\n",
+				__atomic_load_n(
+					sharedBest,
+					__ATOMIC_RELAXED));
+		}
+
+		std::vector<size_t> bestPlanIndices;
+
+		uint64_t evaluated = 0;
+		uint64_t executedFrames = 0;
+		uint64_t stateLoads = 0;
+		uint64_t hiosSeen = 0;
+
+		const auto scanStart =
+			std::chrono::steady_clock::now();
+
+		for (size_t planIndex =
+			     static_cast<size_t>(worker);
+		     planIndex < totalUnique;
+		     planIndex +=
+			     static_cast<size_t>(
+				     workerCount))
+		{
+			if (scanLimit > 0
+			    && evaluated >=
+			       static_cast<uint64_t>(
+				       scanLimit))
+			{
+				break;
+			}
+
+			const minigolf_scan::UniquePlan &u =
+				plans[planIndex];
+
+			const minigolf_scan::Plan &plan =
+				u.plan;
+
+			if (ce_session_load_state(
+					session,
+					baseState.data(),
+					baseState.size()) != 0)
+			{
+				return fail(
+					metaPath,
+					std::string(
+						"scan state load: ")
+					+ ce_session_last_error(
+						session));
+			}
+
+			stateLoads++;
+
+			if (ram[HOLE_ADDRESS]
+			    != START_HOLE)
+			{
+				char buf[200];
+
+				std::snprintf(
+					buf,
+					sizeof buf,
+					"scan: plan %zu restored hole byte %u, expected %u",
+					planIndex,
+					static_cast<unsigned>(
+						ram[HOLE_ADDRESS]),
+					static_cast<unsigned>(
+						START_HOLE));
+
+				return fail(
+					metaPath,
+					buf);
+			}
+
+			/*
+			 * Include the current incumbent frame so that equal
+			 * optimal results are not lost.
+			 */
+
+			if (sharedBest)
+			{
+				const int32_t shared =
+					__atomic_load_n(
+						sharedBest,
+						__ATOMIC_RELAXED);
+
+				if (shared > 0 &&
+				    shared <= maxFrames &&
+				    shared < bestScore)
+				{
+					bestScore =
+						shared;
+
+					bestPlanIndices.clear();
+				}
+			}
+
+int64_t cutoff =
+				bestScore <= maxFrames
+					? bestScore
+					: maxFrames;
+
+			int64_t score = -1;
+
+			for (int64_t n = 0;
+			     n < cutoff;
+			     n++)
+			{
+				/*
+				 * Always explicitly drive the private button.
+				 * The hybrid core consumes it before guest input.
+				 */
+				ce_session_set_button(
+					session,
+					SEARCH_DYNAMIC_BUTTON,
+					(switchDynamic
+					 && n == 0)
+						? 1
+						: 0);
+
+				if (static_cast<size_t>(n)
+				    < plan.frames.size())
+				{
+					setMouse(
+						plan.frames[
+							static_cast<size_t>(
+								n)]);
+				}
+				else
+				{
+					setMouse(
+						neutral);
+				}
+
+				ce_session_frame_advance(
+					session,
+					0,
+					0);
+
+				executedFrames++;
+
+				if (const char *death =
+						ce_session_guest_death(
+							session))
+				{
+					char buf[512];
+
+					std::snprintf(
+						buf,
+						sizeof buf,
+						"scan guest death at plan %zu: %s",
+						planIndex,
+						death);
+
+					return fail(
+						metaPath,
+						buf);
+				}
+
+				const uint8_t hole =
+					ram[HOLE_ADDRESS];
+
+				if (hole == NEXT_HOLE)
+				{
+					score = n + 1;
+					break;
+				}
+
+				if (hole != START_HOLE)
+				{
+					char buf[256];
+
+					std::snprintf(
+						buf,
+						sizeof buf,
+						"scan: unexpected hole byte %u at plan %zu after %lld advances",
+						static_cast<unsigned>(
+							hole),
+						planIndex,
+						static_cast<long long>(
+							n + 1));
+
+					return fail(
+						metaPath,
+						buf);
+				}
+			}
+
+			evaluated++;
+
+			if (score >= 0)
+			{
+				hiosSeen++;
+
+				if (sharedBest)
+				{
+					int32_t current =
+						__atomic_load_n(
+							sharedBest,
+							__ATOMIC_RELAXED);
+
+					while (score < current)
+					{
+						int32_t expected =
+							current;
+
+						if (__atomic_compare_exchange_n(
+								sharedBest,
+								&expected,
+								static_cast<int32_t>(
+									score),
+								false,
+								__ATOMIC_SEQ_CST,
+								__ATOMIC_SEQ_CST))
+						{
+							std::fprintf(
+								stderr,
+								"SHARED_BEST "
+								"worker=%lld "
+								"score=%lld "
+								"plan=%zu "
+								"raw=%d,%d "
+								"dx=%+d "
+								"dy=%+d\n",
+								static_cast<long long>(
+									worker),
+								static_cast<long long>(
+									score),
+								planIndex,
+								u.canonicalX,
+								u.canonicalY,
+								plan.dx,
+								plan.dy);
+
+							std::fflush(
+								stderr);
+
+							break;
+						}
+
+						current =
+							expected;
+					}
+				}
+
+
+				if (score < bestScore)
+				{
+					bestScore =
+						score;
+
+					bestPlanIndices.clear();
+					bestPlanIndices.push_back(
+						planIndex);
+
+					std::fprintf(
+						stderr,
+						"NEW_BEST "
+						"worker=%lld "
+						"score=%lld "
+						"plan=%zu "
+						"raw=%d,%d "
+						"aliases=%u "
+						"dx=%+d "
+						"dy=%+d "
+						"input_frames=%zu "
+						"evaluated=%llu\n",
+						static_cast<long long>(
+							worker),
+						static_cast<long long>(
+							score),
+						planIndex,
+						u.canonicalX,
+						u.canonicalY,
+						u.aliases,
+						plan.dx,
+						plan.dy,
+						plan.frames.size(),
+						static_cast<unsigned long long>(
+							evaluated));
+
+					std::fflush(stderr);
+				}
+				else if (score == bestScore)
+				{
+					bestPlanIndices.push_back(
+						planIndex);
+
+					std::fprintf(
+						stderr,
+						"TIE_BEST "
+						"worker=%lld "
+						"score=%lld "
+						"plan=%zu "
+						"raw=%d,%d "
+						"aliases=%u "
+						"dx=%+d "
+						"dy=%+d "
+						"input_frames=%zu "
+						"evaluated=%llu\n",
+						static_cast<long long>(
+							worker),
+						static_cast<long long>(
+							score),
+						planIndex,
+						u.canonicalX,
+						u.canonicalY,
+						u.aliases,
+						plan.dx,
+						plan.dy,
+						plan.frames.size(),
+						static_cast<unsigned long long>(
+							evaluated));
+
+					std::fflush(stderr);
+				}
+			}
+
+			if (progressEvery > 0
+			    && evaluated
+			       % static_cast<uint64_t>(
+				       progressEvery)
+			       == 0)
+			{
+				const auto now =
+					std::chrono::
+						steady_clock::now();
+
+				const double seconds =
+					std::chrono::
+						duration<double>(
+							now
+							- scanStart)
+						.count();
+
+				const double rate =
+					seconds > 0
+						? static_cast<double>(
+							evaluated)
+							/ seconds
+						: 0.0;
+
+				std::fprintf(
+					stderr,
+					"PROGRESS "
+					"worker=%lld "
+					"done=%llu/%zu "
+					"best=%lld "
+					"frames=%llu "
+					"rate=%.3f_plans_per_sec\n",
+					static_cast<long long>(
+						worker),
+					static_cast<unsigned long long>(
+						evaluated),
+					assignedTotal,
+					static_cast<long long>(
+						bestScore <= maxFrames
+							? bestScore
+							: -1),
+					static_cast<unsigned long long>(
+						executedFrames),
+					rate);
+
+				std::fflush(stderr);
+			}
+		}
+
+		const auto scanEnd =
+			std::chrono::steady_clock::now();
+
+		const double scanSeconds =
+			std::chrono::duration<double>(
+				scanEnd - scanStart)
+				.count();
+
+		const double candidateRate =
+			scanSeconds > 0
+				? static_cast<double>(
+					evaluated)
+					/ scanSeconds
+				: 0.0;
+
+		const double frameRate =
+			scanSeconds > 0
+				? static_cast<double>(
+					executedFrames)
+					/ scanSeconds
+				: 0.0;
+
+		const int64_t finalBest =
+			bestScore <= maxFrames
+				? bestScore
+				: -1;
+
+		std::fprintf(
+			stderr,
+			"\n=== Exhaustive worker complete ===\n"
+			"worker              : %lld / %lld\n"
+			"evaluated           : %llu\n"
+			"state loads         : %llu\n"
+			"frames executed     : %llu\n"
+			"HIOs observed       : %llu\n"
+			"best score          : %lld\n"
+			"best-plan count     : %zu\n"
+			"scan seconds        : %.3f\n"
+			"plans/sec           : %.3f\n"
+			"guest frames/sec    : %.3f\n",
+			static_cast<long long>(
+				worker),
+			static_cast<long long>(
+				workerCount),
+			static_cast<unsigned long long>(
+				evaluated),
+			static_cast<unsigned long long>(
+				stateLoads),
+			static_cast<unsigned long long>(
+				executedFrames),
+			static_cast<unsigned long long>(
+				hiosSeen),
+			static_cast<long long>(
+				finalBest),
+			bestPlanIndices.size(),
+			scanSeconds,
+			candidateRate,
+			frameRate);
+
+		/*
+		 * Machine-readable final results.  These, rather than the
+		 * transient NEW_BEST lines, are what the merge step consumes.
+		 */
+		for (size_t planIndex :
+		     bestPlanIndices)
+		{
+			const minigolf_scan::UniquePlan &u =
+				plans[planIndex];
+
+			const minigolf_scan::Plan &plan =
+				u.plan;
+
+			std::fprintf(
+				stderr,
+				"SCAN_BEST "
+				"worker=%lld "
+				"score=%lld "
+				"plan=%zu "
+				"raw=%d,%d "
+				"aliases=%u "
+				"x_bounds=%d..%d "
+				"y_bounds=%d..%d "
+				"dx=%+d "
+				"dy=%+d "
+				"input_frames=%zu\n",
+				static_cast<long long>(
+					worker),
+				static_cast<long long>(
+					finalBest),
+				planIndex,
+				u.canonicalX,
+				u.canonicalY,
+				u.aliases,
+				u.minX,
+				u.maxX,
+				u.minY,
+				u.maxY,
+				plan.dx,
+				plan.dy,
+				plan.frames.size());
+		}
+
+		std::fprintf(
+			stderr,
+			"SCAN_RESULT "
+			"worker=%lld "
+			"workers=%lld "
+			"evaluated=%llu "
+			"best=%lld "
+			"ties=%zu "
+			"frames=%llu "
+			"seconds=%.6f\n",
+			static_cast<long long>(
+				worker),
+			static_cast<long long>(
+				workerCount),
+			static_cast<unsigned long long>(
+				evaluated),
+			static_cast<long long>(
+				finalBest),
+			bestPlanIndices.size(),
+			static_cast<unsigned long long>(
+				executedFrames),
+			scanSeconds);
+
+		std::fflush(stderr);
+
+		return 0;
+	}
+
 	std::vector<uint8_t> state;
 	if (rerecord)
 	{
