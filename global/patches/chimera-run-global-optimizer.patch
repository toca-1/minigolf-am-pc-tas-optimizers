+/*
+	 * Hole 3 standalone oracle.
+	 *
+	 * This is NOT part of the exhaustive search logic.  It only verifies
+	 * that the exact C++ planner can reproduce the independently known
+	 * raw target (700,1016) from the verified frame-1047 state.
+	 *
+	 * Expected result: hole byte 2 -> 3 after exactly 44 advances.
+	 */
+	if (std::getenv("MINIGOLF_SCAN_ORACLE"))
+	{
+		if (stateIn.empty())
+			return fail(
+				metaPath,
+				"MINIGOLF_SCAN_ORACLE requires --state");
+
+		const char *switchText =
+			std::getenv("MINIGOLF_SWITCH_DYNAMIC");
+
+		const bool switchDynamic =
+			switchText
+			&& switchText[0] != '\0'
+			&& std::strcmp(switchText, "0") != 0;
+
+		constexpr int32_t SEARCH_DYNAMIC_BUTTON = 11;
+
+		constexpr int64_t HOLE_ADDRESS =
+			0x023DB7B8;
+
+		constexpr uint8_t START_HOLE = 2;
+		constexpr uint8_t NEXT_HOLE = 3;
+		constexpr int64_t MAX_FRAMES = 100;
+
+		std::vector<uint8_t> baseState;
+
+		if (!readWholeFile(
+				stateIn.c_str(),
+				baseState))
+		{
+			return fail(
+				metaPath,
+				"oracle: could not reread state");
+		}
+
+		/*
+		 * Find Physical RAM.
+		 */
+		int32_t ramDomain = -1;
+
+		for (int32_t d = 0;
+		     d < ce_session_domain_count(session);
+		     d++)
+		{
+			const char *name =
+				ce_session_domain_name(
+					session, d);
+
+			if (name
+			    && std::strcmp(
+				    name,
+				    "Physical RAM") == 0)
+			{
+				ramDomain = d;
+				break;
+			}
+		}
+
+		if (ramDomain < 0)
+			return fail(
+				metaPath,
+				"oracle: Physical RAM not found");
+
+		const uint64_t ramPtrValue =
+			ce_session_domain_ptr(
+				session,
+				ramDomain);
+
+		if (ramPtrValue == 0)
+			return fail(
+				metaPath,
+				"oracle: Physical RAM has no direct pointer");
+
+		const uint8_t *ram =
+			reinterpret_cast<const uint8_t *>(
+				static_cast<uintptr_t>(
+					ramPtrValue));
+
+		/*
+		 * Find mouse controls.
+		 */
+		auto findButton =
+			[&](const char *wanted) -> int32_t
+		{
+			for (int64_t i = 0;
+			     i < ce_session_button_count(session);
+			     i++)
+			{
+				const char *name =
+					ce_session_button_name(
+						session, i);
+
+				if (name
+				    && std::strcmp(
+					    name,
+					    wanted) == 0)
+				{
+					return
+						static_cast<int32_t>(i);
+				}
+			}
+
+			return -1;
+		};
+
+		auto findAxis =
+			[&](const char *wanted) -> int32_t
+		{
+			for (int64_t i = 0;
+			     i < ce_session_axis_count(session);
+			     i++)
+			{
+				const char *name =
+					ce_session_axis_name(
+						session, i);
+
+				if (name
+				    && std::strcmp(
+					    name,
+					    wanted) == 0)
+				{
+					return
+						static_cast<int32_t>(i);
+				}
+			}
+
+			return -1;
+		};
+
+		const int32_t mouseLeft =
+			findButton("Mouse Left Button");
+
+		const int32_t mouseX =
+			findAxis("Mouse Position X");
+
+		const int32_t mouseY =
+			findAxis("Mouse Position Y");
+
+		const int32_t mouseDX =
+			findAxis("Mouse Speed X");
+
+		const int32_t mouseDY =
+			findAxis("Mouse Speed Y");
+
+		if (mouseLeft < 0
+		    || mouseX < 0
+		    || mouseY < 0
+		    || mouseDX < 0
+		    || mouseDY < 0)
+		{
+			return fail(
+				metaPath,
+				"oracle: DOSBox-X mouse controls not found");
+		}
+
+		if (switchDynamic
+		    && ce_session_button_count(session)
+		       <= SEARCH_DYNAMIC_BUTTON)
+		{
+			return fail(
+				metaPath,
+				"oracle: dynamic-switch button missing");
+		}
+
+		auto setMouse =
+			[&](const minigolf_scan::MouseFrame &f)
+		{
+			ce_session_set_axis(
+				session, mouseX, f.x);
+
+			ce_session_set_axis(
+				session, mouseY, f.y);
+
+			ce_session_set_axis(
+				session, mouseDX, f.speedX);
+
+			ce_session_set_axis(
+				session, mouseDY, f.speedY);
+
+			ce_session_set_button(
+				session,
+				mouseLeft,
+				f.left);
+		};
+
+		/*
+		 * Explicitly restore our verified Hole 3 base state.
+		 */
+		if (ce_session_load_state(
+				session,
+				baseState.data(),
+				baseState.size()) != 0)
+		{
+			return fail(
+				metaPath,
+				std::string(
+					"oracle state load: ")
+				+ ce_session_last_error(
+					session));
+		}
+
+		if (ram[HOLE_ADDRESS] != START_HOLE)
+		{
+			char buf[128];
+
+			std::snprintf(
+				buf,
+				sizeof buf,
+				"oracle: restored hole byte was %u, expected %u",
+				static_cast<unsigned>(
+					ram[HOLE_ADDRESS]),
+				static_cast<unsigned>(
+					START_HOLE));
+
+			return fail(metaPath, buf);
+		}
+
+		const minigolf_scan::Plan plan =
+			minigolf_scan::build_plan(
+				700,
+				1016);
+
+		std::fprintf(
+			stderr,
+			"\n=== Hole 3 known-shot oracle ===\n"
+			"target              : 700,1016\n"
+			"displacement        : %+d,%+d\n"
+			"generated frames    : %zu\n"
+			"execution core      : %s\n",
+			plan.dx,
+			plan.dy,
+			plan.frames.size(),
+			switchDynamic
+				? "dynamic_x86 after frame-0 switch"
+				: "normal");
+
+		int64_t score = -1;
+
+		const minigolf_scan::MouseFrame neutral{
+			1280,
+			1024,
+			0,
+			0,
+			0
+		};
+
+		for (int64_t n = 0;
+		     n < MAX_FRAMES;
+		     n++)
+		{
+			/*
+			 * In the hybrid package this button is intercepted
+			 * before guest input processing and switches the
+			 * DOSBox-X CPU core.
+			 */
+			if (switchDynamic)
+			{
+				ce_session_set_button(
+					session,
+					SEARCH_DYNAMIC_BUTTON,
+					n == 0 ? 1 : 0);
+			}
+
+			if (static_cast<size_t>(n)
+			    < plan.frames.size())
+			{
+				setMouse(
+					plan.frames[
+						static_cast<size_t>(
+							n)]);
+			}
+			else
+			{
+				setMouse(neutral);
+			}
+
+			ce_session_frame_advance(
+				session,
+				0,
+				0);
+
+			if (const char *death =
+					ce_session_guest_death(
+						session))
+			{
+				return fail(
+					metaPath,
+					std::string(
+						"oracle guest death: ")
+					+ death);
+			}
+
+			const uint8_t hole =
+				ram[HOLE_ADDRESS];
+
+			if (hole == NEXT_HOLE)
+			{
+				score = n + 1;
+				break;
+			}
+
+			if (hole != START_HOLE)
+			{
+				char buf[160];
+
+				std::snprintf(
+					buf,
+					sizeof buf,
+					"oracle: unexpected hole byte %u after %lld advances",
+					static_cast<unsigned>(
+						hole),
+					static_cast<long long>(
+						n + 1));
+
+				return fail(
+					metaPath,
+					buf);
+			}
+		}
+
+		std::fprintf(
+			stderr,
+			"hole transition     : %u -> %u\n"
+			"score               : %lld frames\n",
+			static_cast<unsigned>(
+				START_HOLE),
+			static_cast<unsigned>(
+				score >= 0
+					? NEXT_HOLE
+					: START_HOLE),
+			static_cast<long long>(
+				score));
+
+		if (score != 44)
+		{
+			char buf[160];
+
+			std::snprintf(
+				buf,
+				sizeof buf,
+				"oracle: expected known Hole 3 score 44, got %lld",
+				static_cast<long long>(
+					score));
+
+			return fail(
+				metaPath,
+				buf);
+		}
+
+		std::fprintf(
+			stderr,
+			"oracle result       : PASS\n");
+
+		return 0;
+	}
+
