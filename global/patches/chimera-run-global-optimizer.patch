+/*
+	 * Temporary Minigolf hot-loop benchmark.
+	 *
+	 * Usage:
+	 *   MINIGOLF_BENCH=100 chimera-run ... --state STATE --frames 0
+	 *
+	 * Repeatedly:
+	 *   restore exact frame-3272 state
+	 *   execute known synthetic Hole 16 shot
+	 *   poll one RAM byte until 15 -> 16
+	 */
+	if (const char *benchText = std::getenv("MINIGOLF_BENCH"))
+	{
+		const int64_t trials = std::atoll(benchText);
+		if (trials <= 0)
+			return fail(metaPath, "MINIGOLF_BENCH must be > 0");
+
+		if (stateIn.empty())
+			return fail(metaPath, "MINIGOLF_BENCH requires --state");
+
+		/*
+		 * Experimental hybrid CPU-core mode.
+		 *
+		 * The hybrid DOSBox-X core treats button index 11
+		 * (P2 Joystick Button 2, with joystick 2 disabled)
+		 * as an out-of-band request to switch from normal
+		 * to dynamic_x86 on the first candidate frame.
+		 */
+		const char *switchText =
+			std::getenv("MINIGOLF_SWITCH_DYNAMIC");
+
+		const bool switchDynamic =
+			switchText
+			&& switchText[0] != '\0'
+			&& std::strcmp(switchText, "0") != 0;
+
+		constexpr int32_t SEARCH_DYNAMIC_BUTTON = 11;
+
+		if (switchDynamic)
+		{
+			if (ce_session_button_count(session)
+				<= SEARCH_DYNAMIC_BUTTON)
+			{
+				return fail(metaPath,
+					"benchmark: hybrid switch button index missing");
+			}
+
+			const char *switchName =
+				ce_session_button_name(
+					session, SEARCH_DYNAMIC_BUTTON);
+
+			fprintf(stderr,
+				"benchmark: dynamic switch enabled via "
+				"button %d (%s)\n",
+				SEARCH_DYNAMIC_BUTTON,
+				switchName ? switchName : "<unnamed>");
+		}
+
+		std::vector<uint8_t> baseState;
+		if (!readWholeFile(stateIn.c_str(), baseState))
+			return fail(metaPath, "could not reread benchmark state");
+
+		constexpr int64_t HOLE_ADDRESS = 0x023DB7B8;
+		constexpr uint8_t EXPECTED_HOLE = 15;
+		constexpr int64_t MAX_FRAMES = 100;
+
+		/* Locate Physical RAM. */
+		int32_t ramDomain = -1;
+		for (int32_t d = 0; d < ce_session_domain_count(session); d++)
+		{
+			const char *name = ce_session_domain_name(session, d);
+			if (name && std::strcmp(name, "Physical RAM") == 0)
+			{
+				ramDomain = d;
+				break;
+			}
+		}
+		if (ramDomain < 0)
+			return fail(metaPath, "benchmark: Physical RAM not found");
+
+		const uint64_t ramPtrValue =
+			ce_session_domain_ptr(session, ramDomain);
+
+		if (ramPtrValue == 0)
+			return fail(metaPath,
+				"benchmark: Physical RAM has no direct pointer");
+
+		const uint8_t *ram =
+			reinterpret_cast<const uint8_t *>(
+				static_cast<uintptr_t>(ramPtrValue));
+
+		/* Locate DOSBox-X mouse controls by name. */
