+
+			for (int64_t n = 0;
+			     n < cutoff;
+			     n++)
+			{
+				/*
+				 * Always explicitly drive the private button.
+				 * The hybrid core consumes it before guest input.
+				 */
+				ce_session_set_button(
+					session,
+					SEARCH_DYNAMIC_BUTTON,
+					(switchDynamic
+					 && n == 0)
+						? 1
+						: 0);
+
+				if (static_cast<size_t>(n)
+				    < plan.frames.size())
+				{
+					setMouse(
+						plan.frames[
+							static_cast<size_t>(
+								n)]);
+				}
+				else
+				{
+					setMouse(
+						neutral);
+				}
+
+				ce_session_frame_advance(
+					session,
+					0,
+					0);
+
+				executedFrames++;
+
+				if (const char *death =
+						ce_session_guest_death(
+							session))
+				{
+					char buf[512];
+
+					std::snprintf(
+						buf,
+						sizeof buf,
+						"scan guest death at plan %zu: %s",
+						planIndex,
+						death);
+
+					return fail(
+						metaPath,
+						buf);
+				}
+
+				const uint8_t hole =
+					ram[HOLE_ADDRESS];
+
+				if (hole == NEXT_HOLE)
+				{
+					score = n + 1;
+					break;
+				}
+
+				if (hole != START_HOLE)
+				{
+					char buf[256];
+
+					std::snprintf(
+						buf,
+						sizeof buf,
+						"scan: unexpected hole byte %u at plan %zu after %lld advances",
+						static_cast<unsigned>(
+							hole),
+						planIndex,
+						static_cast<long long>(
+							n + 1));
+
+					return fail(
+						metaPath,
+						buf);
+				}
+			}
+
+			evaluated++;
+
+			if (score >= 0)
+			{
+				hiosSeen++;
+
+				if (sharedBest)
+				{
+					int32_t current =
+						__atomic_load_n(
+							sharedBest,
+							__ATOMIC_RELAXED);
+
+					while (score < current)
+					{
+						int32_t expected =
+							current;
+
+						if (__atomic_compare_exchange_n(
+								sharedBest,
+								&expected,
+								static_cast<int32_t>(
+									score),
+								false,
+								__ATOMIC_SEQ_CST,
+								__ATOMIC_SEQ_CST))
+						{
+							std::fprintf(
+								stderr,
+								"SHARED_BEST "
+								"worker=%lld "
+								"score=%lld "
+								"plan=%zu "
+								"raw=%d,%d "
+								"dx=%+d "
+								"dy=%+d\n",
+								static_cast<long long>(
+									worker),
+								static_cast<long long>(
+									score),
+								planIndex,
+								u.canonicalX,
+								u.canonicalY,
+								plan.dx,
+								plan.dy);
+
+							std::fflush(
+								stderr);
+
+							break;
+						}
+
+						current =
+							expected;
+					}
+				}
+
+
+				if (score < bestScore)
+				{
+					bestScore =
+						score;
+
+					bestPlanIndices.clear();
+					bestPlanIndices.push_back(
+						planIndex);
+
+					std::fprintf(
+						stderr,
+						"NEW_BEST "
+						"worker=%lld "
+						"score=%lld "
+						"plan=%zu "
+						"raw=%d,%d "
+						"aliases=%u "
+						"dx=%+d "
+						"dy=%+d "
+						"input_frames=%zu "
+						"evaluated=%llu\n",
+						static_cast<long long>(
+							worker),
+						static_cast<long long>(
+							score),
+						planIndex,
+						u.canonicalX,
+						u.canonicalY,
+						u.aliases,
+						plan.dx,
+						plan.dy,
+						plan.frames.size(),
+						static_cast<unsigned long long>(
+							evaluated));
+
+					std::fflush(stderr);
+				}
+				else if (score == bestScore)
+				{
+					bestPlanIndices.push_back(
+						planIndex);
+
+					std::fprintf(
+						stderr,
+						"TIE_BEST "
+						"worker=%lld "
+						"score=%lld "
+						"plan=%zu "
+						"raw=%d,%d "
+						"aliases=%u "
+						"dx=%+d "
+						"dy=%+d "
+						"input_frames=%zu "
+						"evaluated=%llu\n",
+						static_cast<long long>(
+							worker),
+						static_cast<long long>(
+							score),
+						planIndex,
+						u.canonicalX,
+						u.canonicalY,
+						u.aliases,
+						plan.dx,
+						plan.dy,
+						plan.frames.size(),
+						static_cast<unsigned long long>(
+							evaluated));
+
+					std::fflush(stderr);
+				}
+			}
+
+			if (progressEvery > 0
+			    && evaluated
+			       % static_cast<uint64_t>(
+				       progressEvery)
+			       == 0)
+			{
+				const auto now =
+					std::chrono::
+						steady_clock::now();
+
+				const double seconds =
+					std::chrono::
+						duration<double>(
+							now
+							- scanStart)
+						.count();
+
+				const double rate =
+					seconds > 0
+						? static_cast<double>(
+							evaluated)
+							/ seconds
+						: 0.0;
+
+				std::fprintf(
+					stderr,
+					"PROGRESS "
+					"worker=%lld "
+					"done=%llu/%zu "
+					"best=%lld "
+					"frames=%llu "
+					"rate=%.3f_plans_per_sec\n",
+					static_cast<long long>(
+						worker),
+					static_cast<unsigned long long>(
+						evaluated),
+					assignedTotal,
+					static_cast<long long>(
+						bestScore <= maxFrames
+							? bestScore
+							: -1),
+					static_cast<unsigned long long>(
+						executedFrames),
+					rate);
+
+				std::fflush(stderr);
+			}
+		}
+
+		const auto scanEnd =
+			std::chrono::steady_clock::now();
+
+		const double scanSeconds =
+			std::chrono::duration<double>(
+				scanEnd - scanStart)
+				.count();
+
+		const double candidateRate =
+			scanSeconds > 0
+				? static_cast<double>(
+					evaluated)
+					/ scanSeconds
+				: 0.0;
+
+		const double frameRate =
+			scanSeconds > 0
+				? static_cast<double>(
+					executedFrames)
+					/ scanSeconds
+				: 0.0;
+
+		const int64_t finalBest =
+			bestScore <= maxFrames
+				? bestScore
+				: -1;
+
+		std::fprintf(
+			stderr,
+			"\n=== Exhaustive worker complete ===\n"
+			"worker              : %lld / %lld\n"
+			"evaluated           : %llu\n"
+			"state loads         : %llu\n"
+			"frames executed     : %llu\n"
+			"HIOs observed       : %llu\n"
+			"best score          : %lld\n"
+			"best-plan count     : %zu\n"
+			"scan seconds        : %.3f\n"
+			"plans/sec           : %.3f\n"
+			"guest frames/sec    : %.3f\n",
+			static_cast<long long>(
+				worker),
+			static_cast<long long>(
+				workerCount),
+			static_cast<unsigned long long>(
+				evaluated),
+			static_cast<unsigned long long>(
+				stateLoads),
+			static_cast<unsigned long long>(
+				executedFrames),
+			static_cast<unsigned long long>(
+				hiosSeen),
+			static_cast<long long>(
+				finalBest),
+			bestPlanIndices.size(),
+			scanSeconds,
+			candidateRate,
+			frameRate);
+
+		/*
+		 * Machine-readable final results.  These, rather than the
+		 * transient NEW_BEST lines, are what the merge step consumes.
+		 */
+		for (size_t planIndex :
+		     bestPlanIndices)
+		{
+			const minigolf_scan::UniquePlan &u =
+				plans[planIndex];
+
+			const minigolf_scan::Plan &plan =
+				u.plan;
+
+			std::fprintf(
+				stderr,
+				"SCAN_BEST "
+				"worker=%lld "
+				"score=%lld "
+				"plan=%zu "
+				"raw=%d,%d "
+				"aliases=%u "
+				"x_bounds=%d..%d "
+				"y_bounds=%d..%d "
+				"dx=%+d "
+				"dy=%+d "
+				"input_frames=%zu\n",
+				static_cast<long long>(
+					worker),
+				static_cast<long long>(
+					finalBest),
+				planIndex,
+				u.canonicalX,
+				u.canonicalY,
+				u.aliases,
+				u.minX,
+				u.maxX,
+				u.minY,
+				u.maxY,
+				plan.dx,
+				plan.dy,
+				plan.frames.size());
+		}
+
+		std::fprintf(
+			stderr,
+			"SCAN_RESULT "
+			"worker=%lld "
+			"workers=%lld "
+			"evaluated=%llu "
+			"best=%lld "
+			"ties=%zu "
+			"frames=%llu "
+			"seconds=%.6f\n",
+			static_cast<long long>(
+				worker),
+			static_cast<long long>(
+				workerCount),
+			static_cast<unsigned long long>(
+				evaluated),
+			static_cast<long long>(
+				finalBest),
+			bestPlanIndices.size(),
+			static_cast<unsigned long long>(
+				executedFrames),
+			scanSeconds);
+
+		std::fflush(stderr);
+
+		return 0;
+	}
+
