+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <stdexcept>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace minigolf_scan
+{
+
+/*
+ * Default planner configuration.
+ *
+ * The exhaustive scanner overrides the cursor and starting-carrier
+ * values at runtime for the course being searched.
+ *
+ * Video:               640x480
+ * Display Input plane: 2560x2048
+ */
+static constexpr int CURSOR_X = 672;
+static constexpr int CURSOR_Y = 644;
+
+static constexpr int START_AXIS_X = 1280;
+static constexpr int START_AXIS_Y = 1024;
+
+static constexpr int VIDEO_W = 640;
+static constexpr int VIDEO_H = 480;
+
+static constexpr int X_MIN = 0;
+static constexpr int X_MAX = 2560;
+static constexpr int X_NEUTRAL = 1280;
+
+static constexpr int Y_MIN = 0;
+static constexpr int Y_MAX = 2048;
+static constexpr int Y_NEUTRAL = 1024;
+
+static constexpr int LEGAL_X_MIN = 12;
+static constexpr int LEGAL_X_MAX = 2536;
+static constexpr int LEGAL_Y_MIN = 260;
+static constexpr int LEGAL_Y_MAX = 2018;
+
+static constexpr int MAX_POSITION_DELTA = 255;
+static constexpr int MAX_EXPLICIT_SPEED = 180;
+
+static constexpr int CLICK_NUDGE_X = 0;
+static constexpr int CLICK_NUDGE_Y = 1;
+
+/*
+ * Runtime planner state.
+ *
+ * The exhaustive scanner overrides these values before generating
+ * candidate plans.
+ */
+static int ACTIVE_CURSOR_X = CURSOR_X;
+static int ACTIVE_CURSOR_Y = CURSOR_Y;
+static int ACTIVE_START_AXIS_X = START_AXIS_X;
+static int ACTIVE_START_AXIS_Y = START_AXIS_Y;
+
+static inline void configure_planner(
+	int cursorX,
+	int cursorY,
+	int startAxisX,
+	int startAxisY)
+{
+	ACTIVE_CURSOR_X = cursorX;
+	ACTIVE_CURSOR_Y = cursorY;
+	ACTIVE_START_AXIS_X = startAxisX;
+	ACTIVE_START_AXIS_Y = startAxisY;
+}
+
+struct AxisStep
+{
+	int pos;
+	int speed;
+	int moved;
+};
+
+struct PathPoint
+{
+	int x;
+	int y;
+	int speedX;
+	int speedY;
+	int movedX;
+	int movedY;
+};
+
+struct MouseFrame
+{
+	int32_t x;
+	int32_t y;
+	int32_t speedX;
+	int32_t speedY;
+	int32_t left;
+};
+
+struct Plan
+{
+	int targetX = 0;
+	int targetY = 0;
+	int dx = 0;
+	int dy = 0;
+
+	int moveFrames = 0;
+	int finalAxisX = 0;
+	int finalAxisY = 0;
+
+	int nudgeX = 0;
+	int nudgeY = 0;
+
+	std::vector<MouseFrame> frames;
+};
+
+struct UniquePlan
+{
+	Plan plan;
+
+	/* First raw coordinate encountered: canonical representative. */
+	int canonicalX = 0;
+	int canonicalY = 0;
+
+	/* Raw-coordinate class bounds and size. */
+	int minX = 0;
+	int maxX = 0;
+	int minY = 0;
+	int maxY = 0;
+	uint32_t aliases = 0;
+};
+
+/*
+ * Lua round_nearest():
+ *
+ *   v >= 0 -> floor(v + 0.5)
+ *   v <  0 -> ceil (v - 0.5)
+ *
+ * Do it as integer rational arithmetic so no floating-point rounding
+ * differences can creep into the exhaustive enumerator.
+ */
+static inline int round_ratio_half_away(int64_t numerator,
+                                        int64_t denominator)
+{
+	const bool negative = numerator < 0;
+	uint64_t a = static_cast<uint64_t>(
+		negative ? -numerator : numerator);
+
+	uint64_t q = a / static_cast<uint64_t>(denominator);
+	const uint64_t r =
+		a % static_cast<uint64_t>(denominator);
+
+	if (r * 2 >= static_cast<uint64_t>(denominator))
+		q++;
+
+	const int out = static_cast<int>(q);
+	return negative ? -out : out;
+}
+
+static inline void cursor_delta_to_mickeys(
+	int targetX,
+	int targetY,
+	int &dx,
+	int &dy)
+{
+	dx = round_ratio_half_away(
+		static_cast<int64_t>(targetX - ACTIVE_CURSOR_X) * VIDEO_W,
+		X_MAX - X_MIN);
+
+	dy = round_ratio_half_away(
+		static_cast<int64_t>(targetY - ACTIVE_CURSOR_Y) * VIDEO_H,
+		Y_MAX - Y_MIN);
+}
+
+static inline AxisStep plan_axis_frame(
+	int pos,
+	int remaining,
+	int minv,
+	int maxv)
+{
+	if (remaining == 0)
+		return {pos, 0, 0};
+
+	const int dir = remaining > 0 ? 1 : -1;
+	const int amount =
+		remaining > 0 ? remaining : -remaining;
+
+	const int room =
+		dir > 0 ? (maxv - pos) : (pos - minv);
+
+	int positionAmount = amount;
+	if (positionAmount > MAX_POSITION_DELTA)
+		positionAmount = MAX_POSITION_DELTA;
+	if (positionAmount > room)
+		positionAmount = room;
+
+	int explicitAmount = amount;
+	if (explicitAmount > MAX_EXPLICIT_SPEED)
+		explicitAmount = MAX_EXPLICIT_SPEED;
+
+	if (positionAmount >= explicitAmount &&
+	    positionAmount > 0)
+	{
+		const int moved = dir * positionAmount;
+		return {pos + moved, 0, moved};
+	}
+
+	const int moved = dir * explicitAmount;
+
+	/*
+	 * Explicit Mouse Speed takes precedence for guest motion,
+	 * while the absolute carrier is moved to the opposite boundary
+	 * to re-arm it for a later position-derived frame.
+	 */
+	const int rearmedPos =
+		dir > 0 ? minv : maxv;
+
+	return {rearmedPos, moved, moved};
+}
+
+static inline bool fit_click_nudge(
+	int pos,
+	int requested,
+	int minv,
+	int maxv,
+	int pressSpeed,
+	int pressMoved,
+	int &result)
+{
+	if (requested == 0)
+	{
+		result = 0;
+		return true;
+	}
+
+	auto fits = [&](int n) -> bool
+	{
+		if (pos + n < minv || pos + n > maxv)
+			return false;
+
+		if (pressSpeed != 0)
+		{
+			const int v = pressSpeed + n;
+			if (v < -MAX_EXPLICIT_SPEED ||
+			    v >  MAX_EXPLICIT_SPEED)
+				return false;
+		}
+		else
+		{
+			const int v = pressMoved + n;
+			if (v < -MAX_POSITION_DELTA ||
+			    v >  MAX_POSITION_DELTA)
+				return false;
+		}
+
+		return true;
+	};
+
+	if (fits(requested))
+	{
+		result = requested;
+		return true;
+	}
+
+	if (fits(-requested))
+	{
+		result = -requested;
+		return true;
+	}
+
+	return false;
+}
+
+static inline Plan build_plan(int targetX, int targetY)
+{
+	Plan plan;
+	plan.targetX = targetX;
+	plan.targetY = targetY;
+
+	cursor_delta_to_mickeys(
+		targetX, targetY,
+		plan.dx, plan.dy);
+
+	std::vector<PathPoint> path;
+
+	int axisX = ACTIVE_START_AXIS_X;
+	int axisY = ACTIVE_START_AXIS_Y;
+	int remX = plan.dx;
+	int remY = plan.dy;
+
+	while (remX != 0 || remY != 0)
+	{
+		const AxisStep sx =
+			plan_axis_frame(
+				axisX, remX,
+				X_MIN, X_MAX);
+
+		const AxisStep sy =
+			plan_axis_frame(
+				axisY, remY,
+				Y_MIN, Y_MAX);
+
+		path.push_back({
+			sx.pos,
+			sy.pos,
+			sx.speed,
+			sy.speed,
+			sx.moved,
+			sy.moved
+		});
+
+		axisX = sx.pos;
+		axisY = sy.pos;
+
+		remX -= sx.moved;
+		remY -= sy.moved;
+
+		if (path.size() > 64)
+			throw std::runtime_error(
+				"mouse path exceeded 64 frames");
+	}
+
+	plan.moveFrames =
+		static_cast<int>(path.size());
+
+	plan.finalAxisX = axisX;
+	plan.finalAxisY = axisY;
+
+	/*
+	 * Fastest possible click:
+	 *
+	 * If movement exists, press on its final frame.
+	 * With no movement, press on candidate frame zero.
+	 */
+	const int pressFrame =
+		path.empty()
+			? 0
+			: static_cast<int>(path.size()) - 1;
+
+	const int releaseFrame =
+		pressFrame + 1;
+
+	int pressSpeedX = 0;
+	int pressSpeedY = 0;
+	int pressMovedX = 0;
+	int pressMovedY = 0;
+
+	if (!path.empty())
+	{
+		const PathPoint &p = path.back();
+
+		pressSpeedX = p.speedX;
+		pressSpeedY = p.speedY;
+		pressMovedX = p.movedX;
+		pressMovedY = p.movedY;
+	}
+
+	if (!fit_click_nudge(
+			axisX,
+			CLICK_NUDGE_X,
+			X_MIN, X_MAX,
+			pressSpeedX,
+			pressMovedX,
+			plan.nudgeX))
+	{
+		throw std::runtime_error(
+			"could not fit X click nudge");
+	}
+
+	if (!fit_click_nudge(
+			axisY,
+			CLICK_NUDGE_Y,
+			Y_MIN, Y_MAX,
+			pressSpeedY,
+			pressMovedY,
+			plan.nudgeY))
+	{
+		throw std::runtime_error(
+			"could not fit Y click nudge");
+	}
+
+	/*
+	 * Path frames.
+	 */
+	for (size_t i = 0; i < path.size(); i++)
+	{
+		const int f = static_cast<int>(i);
+		const bool left = (f == pressFrame);
+
+		int x = path[i].x;
+		int y = path[i].y;
+		int speedX = path[i].speedX;
+		int speedY = path[i].speedY;
+
+		if (left)
+		{
+			x += plan.nudgeX;
+			y += plan.nudgeY;
+
+			if (speedX != 0)
+				speedX += plan.nudgeX;
+
+			if (speedY != 0)
+				speedY += plan.nudgeY;
+		}
+
+		plan.frames.push_back({
+			x, y,
+			speedX, speedY,
+			left ? 1 : 0
+		});
+	}
+
+	/*
+	 * Stationary press/release portion.
+	 *
+	 * For a moving shot this contributes only the release frame.
+	 * For a zero-displacement shot this writes both press and release.
+	 */
+	const int firstStationary =
+		path.empty()
+			? 0
+			: static_cast<int>(path.size());
+
+	for (int f = firstStationary;
+	     f <= releaseFrame;
+	     f++)
+	{
+		const bool left = (f == pressFrame);
+
+		int x = axisX;
+		int y = axisY;
+
+		if (left)
+		{
+			x += plan.nudgeX;
+			y += plan.nudgeY;
+		}
+
+		plan.frames.push_back({
+			x, y,
+			0, 0,
+			left ? 1 : 0
+		});
+	}
+
+	/*
+	 * Re-arm TAStudio's position carriers to neutral after release.
+	 *
+	 * First cleanup frame: one-mickey excursion.
+	 * Second cleanup frame: the opposite position-derived mickey
+	 * returns the guest cursor to the same final location.
+	 */
+	if (axisX != X_NEUTRAL ||
+	    axisY != Y_NEUTRAL)
+	{
+		int sx = 0;
+		int sy = 0;
+
+		int stageX = X_NEUTRAL;
+		int stageY = Y_NEUTRAL;
+
+		if (axisX != X_NEUTRAL)
+		{
+			sx = axisX < X_NEUTRAL ? 1 : -1;
+			stageX = X_NEUTRAL + sx;
+		}
+
+		if (axisY != Y_NEUTRAL)
+		{
+			sy = axisY < Y_NEUTRAL ? 1 : -1;
+			stageY = Y_NEUTRAL + sy;
+		}
+
+		plan.frames.push_back({
+			stageX, stageY,
+			sx, sy,
+			0
+		});
+
+		plan.frames.push_back({
+			X_NEUTRAL,
+			Y_NEUTRAL,
+			0, 0,
+			0
+		});
+	}
+
+	return plan;
+}
+
+/*
+ * Binary key for the COMPLETE generated input sequence.
+ *
+ * We deliberately dedupe the actual sequence delivered to DOSBox-X,
+ * rather than merely assuming equal raw coordinates or equal dx/dy
+ * are equivalent.
+ */
+static inline void append_i32(
+	std::string &s,
+	int32_t v)
+{
+	const uint32_t u =
+		static_cast<uint32_t>(v);
+
+	s.push_back(
+		static_cast<char>((u >> 0) & 0xff));
+	s.push_back(
+		static_cast<char>((u >> 8) & 0xff));
+	s.push_back(
+		static_cast<char>((u >> 16) & 0xff));
+	s.push_back(
+		static_cast<char>((u >> 24) & 0xff));
+}
+
+static inline std::string plan_signature(
+	const Plan &plan)
+{
+	std::string s;
+
+	s.reserve(
+		4 +
+		plan.frames.size() * 20);
+
+	append_i32(
+		s,
+		static_cast<int32_t>(
+			plan.frames.size()));
+
+	for (const MouseFrame &f : plan.frames)
+	{
+		append_i32(s, f.x);
+		append_i32(s, f.y);
+		append_i32(s, f.speedX);
+		append_i32(s, f.speedY);
+		append_i32(s, f.left);
+	}
+
+	return s;
+}
+
+static inline std::vector<UniquePlan>
+enumerate_unique_plans_range(
+	int xMin,
+	int xMax,
+	int yMin,
+	int yMax)
+{
+	std::vector<UniquePlan> unique;
+	unique.reserve(270000);
+
+	std::unordered_map<std::string, size_t> seen;
+	seen.reserve(300000);
+
+	for (int x = xMin;
+	     x <= xMax;
+	     x++)
+	{
+		for (int y = yMin;
+		     y <= yMax;
+		     y++)
+		{
+			Plan plan =
+				build_plan(x, y);
+
+			std::string sig =
+				plan_signature(plan);
+
+			const auto it =
+				seen.find(sig);
+
+			if (it == seen.end())
+			{
+				const size_t index =
+					unique.size();
+
+				UniquePlan u;
+				u.plan = std::move(plan);
+
+				u.canonicalX = x;
+				u.canonicalY = y;
+
+				u.minX = x;
+				u.maxX = x;
+				u.minY = y;
+				u.maxY = y;
+
+				u.aliases = 1;
+
+				unique.push_back(
+					std::move(u));
+
+				seen.emplace(
+					std::move(sig),
+					index);
+			}
+			else
+			{
+				UniquePlan &u =
+					unique[it->second];
+
+				u.aliases++;
+
+				if (x < u.minX) u.minX = x;
+				if (x > u.maxX) u.maxX = x;
+				if (y < u.minY) u.minY = y;
+				if (y > u.maxY) u.maxY = y;
+			}
+		}
+	}
+
+	return unique;
+}
+
+static inline std::vector<UniquePlan>
+enumerate_unique_plans()
+{
+	return enumerate_unique_plans_range(
+		LEGAL_X_MIN,
+		LEGAL_X_MAX,
+		LEGAL_Y_MIN,
+		LEGAL_Y_MAX);
+}
+
+
+static inline int run_precompute()
+{
+	const uint64_t rawCount =
+		static_cast<uint64_t>(
+			LEGAL_X_MAX -
+			LEGAL_X_MIN + 1)
+		*
+		static_cast<uint64_t>(
+			LEGAL_Y_MAX -
+			LEGAL_Y_MIN + 1);
+
+	std::printf(
+		"=== Minigolf exhaustive precompute ===\n");
+
+	std::printf(
+		"cursor              : %d,%d\n",
+		CURSOR_X, CURSOR_Y);
+
+	std::printf(
+		"start carrier       : %d,%d\n",
+		START_AXIS_X,
+		START_AXIS_Y);
+
+	std::printf(
+		"video               : %dx%d\n",
+		VIDEO_W, VIDEO_H);
+
+	std::printf(
+		"legal X             : %d..%d\n",
+		LEGAL_X_MIN,
+		LEGAL_X_MAX);
+
+	std::printf(
+		"legal Y             : %d..%d\n",
+		LEGAL_Y_MIN,
+		LEGAL_Y_MAX);
+
+	std::printf(
+		"raw coordinates     : %llu\n",
+		static_cast<unsigned long long>(
+			rawCount));
+
+	std::fflush(stdout);
+
+	std::vector<UniquePlan> plans =
+		enumerate_unique_plans();
+
+	std::printf(
+		"unique input plans  : %zu\n",
+		plans.size());
+
+	double reduction =
+		plans.empty()
+			? 0.0
+			: static_cast<double>(rawCount)
+				/ static_cast<double>(
+					plans.size());
+
+	std::printf(
+		"dedup factor        : %.4fx\n",
+		reduction);
+
+	std::array<uint64_t, 128> histogram{};
+
+	size_t maxFrames = 0;
+
+	for (size_t i = 0;
+	     i < plans.size();
+	     i++)
+	{
+		const size_t n =
+			plans[i].plan.frames.size();
+
+		if (n < histogram.size())
+			histogram[n]++;
+
+		if (n > maxFrames)
+			maxFrames = n;
+
+
+	}
+
+	std::printf(
+		"max generated frames: %zu\n",
+		maxFrames);
+
+	std::printf(
+		"\nplan length histogram:\n");
+
+	for (size_t i = 0;
+	     i < histogram.size();
+	     i++)
+	{
+		if (histogram[i] != 0)
+		{
+			std::printf(
+				"  %zu frames : %llu plans\n",
+				i,
+				static_cast<unsigned long long>(
+					histogram[i]));
+		}
+	}
+
+	return 0;
+}
